<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tasbeeh_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center"
    android:background="@drawable/widget_card_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tasbeeh_widget_badge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="مسبحة إلكترونية 📿"
            android:textSize="12sp"
            android:textColor="#00E5FF"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/tasbeeh_widget_reset_btn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_widget_refresh"
            android:contentDescription="تصفير" />
    </LinearLayout>

    <TextView
        android:id="@+id/tasbeeh_widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="سُبْحَانَ اللَّهِ"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/tasbeeh_widget_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:textColor="#00E5FF"
        android:textSize="44sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="2dp" />

    <TextView
        android:id="@+id/tasbeeh_widget_goal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="الهدف: 33"
        android:textColor="#B0BEC5"
        android:textSize="12sp"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/tasbeeh_widget_count_btn"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="+1 تسبيح"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:background="#2200E5FF" />

</LinearLayout>
